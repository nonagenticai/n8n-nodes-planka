{
  "name": "@nonagenticai/n8n-nodes-planka",
  "version": "0.1.2",
  "description": "n8n community node for Planka, the open-source kanban board",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nonagenticai/n8n-nodes-planka.git"
  },
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "planka",
    "kanban",
    "project-management"
  ],
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "lint": "eslint \"nodes/**/*.ts\" \"credentials/**/*.ts\"",
    "format": "prettier --write \"**/*.ts\"",
    "docs": "node generate-docs.js",
    "postbuild": "npm run docs",
    "test": "NODE_OPTIONS='--localstorage-file=/tmp/jest-localstorage' jest --testPathIgnorePatterns=integration",
    "test:watch": "NODE_OPTIONS='--localstorage-file=/tmp/jest-localstorage' jest --watch",
    "test:coverage": "NODE_OPTIONS='--localstorage-file=/tmp/jest-localstorage' jest --coverage"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "replaySafe": false,
    "credentials": [
      "dist/credentials/PlankaApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Planka/Planka.node.js"
    ]
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "homepage": "https://nonagentic.ai",
  "overrides": {
    "form-data": "^4.0.4",
    "isolated-vm": "7.0.2"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.0.0",
    "eslint": "^10.0.0",
    "gulp": "^5.0.1",
    "jest": "^30.2.0",
    "n8n-workflow": "^2.16.0",
    "orval": "^8.0.3",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2"
  },
  "author": {
    "name": "NonAgenticAI",
    "url": "https://nonagentic.ai"
  }
}
